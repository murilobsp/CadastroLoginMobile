<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"

    tools:context=".FormCadastro">


    <ImageView
        android:id="@+id/img_cadastrar"
        android:layout_width="350dp"
        android:layout_height="80dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/cardapio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <View
        android:id="@+id/caixaCadastro"
        style="@style/CaixaCadastro"
        android:layout_marginTop="24dp"
        android:background="@drawable/caixalogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"


        app:layout_constraintTop_toBottomOf="@id/img_cadastrar" />

    <EditText
        android:id="@+id/edit_name"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toTopOf="@id/caixaCadastro"
        android:hint="Nome"
        android:textColorHint="#A9A9A9"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_person"
        android:paddingEnd="10dp"
        android:inputType="text"

        />





    <EditText
        android:id="@+id/edit_cpf"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_name"
        android:hint="CPF"
        android:textColorHint="#A9A9A9"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_person"
        android:paddingEnd="10dp"
        android:inputType="number"


        />

    <EditText
        android:id="@+id/edit_nascimento"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        android:hint="Data de Nascimento"
        android:textColorHint="#A9A9A9"
        android:inputType="date"
        android:paddingEnd="10dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintHorizontal_bias="0.275"


        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_cpf" />

    <ImageView
        android:id="@+id/img_calendario"
        android:layout_width="22dp"
        android:layout_height="22dp"

        app:layout_constraintEnd_toEndOf="@id/edit_nascimento"
        app:layout_constraintTop_toTopOf="@id/edit_nascimento"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/imgcalendario"


        />

    <EditText
        android:id="@+id/edit_email"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_nascimento"
        android:hint="Email"
        android:textColorHint="#A9A9A9"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_email"
        android:paddingEnd="10dp"
        android:inputType="textEmailAddress"

        />

    <EditText
        android:id="@+id/edit_senha"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_email"
        android:hint="Senha"
        android:textColorHint="#A9A9A9"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_eye"
        android:paddingEnd="10dp"
        android:inputType="textPassword"


        />

    <EditText
        android:id="@+id/edit_confirmSenha"
        style="@style/Edit_text"
        android:background="@drawable/edit_text"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_senha"
        android:hint="Confirme a senha"
        android:textColorHint="#A9A9A9"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/ic_eye"
        android:paddingEnd="10dp"
        android:inputType="textPassword"

        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonCadastrar"
        style="@style/ButtonLogin"
        app:layout_constraintStart_toStartOf="@id/caixaCadastro"
        app:layout_constraintEnd_toEndOf="@id/caixaCadastro"
        app:layout_constraintTop_toBottomOf="@id/edit_confirmSenha"
        android:background="@drawable/buttonlogin"
        android:text="@string/cadastrar"
        android:layout_height="60dp"

        />

    <ProgressBar
        android:id="@+id/progressbar"
        style="@style/progressbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caixaCadastro"


        />







</androidx.constraintlayout.widget.ConstraintLayout>